# SO-101 servo driver boards (CH343 USB-serial, 1a86:55d3): readable/writable by everyone
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666"
# Stable names, independent of ttyACM numbering (matched by board serial number)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B14031355", SYMLINK+="so100_follower"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", ATTRS{serial}=="5B14110588", SYMLINK+="so100_leader"
